                      className="p-2 border-2 border-gray-400 rounded-md cursor-pointer bg-white text-sm hover:bg-gray-50 w-full flex justify-between items-center h-10"
                      onClick={() => {
                        setIsTypeOpen(!isTypeOpen);
                        setIsRegionOpen(false);
                        setIsSegmentOpen(false);
                        setIsDelegationOpen(false);
                      }}
                    >
                      <span className="truncate">{searchType ? typeOptions.find(t => t.value === searchType)?.label || 'Choisir un type opérateur' : 'Choisir un type opérateur'}</span>
                      <span className="text-blue-950">{isTypeOpen ? '▲' : '▼'}</span>
                    </div>
                    {isTypeOpen && (
                      <div className="absolute z-50 mt-2 w-full bg-white border-2 border-gray-400 rounded-md shadow-lg max-h-[40vh] overflow-auto">
                        <div className="p-2 hover:bg-gray-100 cursor-pointer text-sm" onClick={() => handleTypeSelect('')}>
                          Tous les types
                        </div>
                        {typeOptions.map(t => (
                          <div key={t.value} className="p-2 hover:bg-gray-100 cursor-pointer text-sm" onClick={() => handleTypeSelect(t.value)}>
                            {t.label}
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                </td>
                <td className="w-[15%] px-2">
                  <div className="relative" ref={regionRef}>

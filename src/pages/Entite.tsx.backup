                            </div>
                            <div
  className="p-2 hover:bg-gray-100 cursor-pointer text-sm"
  onClick={handleExport}
>
  Exporter
</div>
                          </div>
                        )}
                      </div>
                    )}
                  </div>
                </td>
                <td className="w-[7%] px-2"></td>
              </tr>
            </tbody>
          </table>
          <div className="mt-4 overflow-visible" ref={tableRef}>
            <table className="w-full text-sm table-fixed">
              <thead className="bg-blue-950 text-white sticky top-0 z-10">
                <tr>
                  <th className="w-[5%] p-2"></th>
                  <th className="w-[5%] p-2 cursor-pointer" onClick={() => handleSort('id_entite')}>
                    ID {sortConfig?.key === 'id_entite' && (sortConfig.direction === 'ascending' ? '▲' : '▼')}
                  </th>
                  <th className="w-[5%] p-2">Logo</th>
                  <th className="w-[10%] p-2 cursor-pointer" onClick={() => handleSort('raison_socialle')}>

                            <div>
                              <p><strong>Identifiant REX:</strong> {company.identifiant_rex || 'N/A'}</p>
                              <p><strong>Date enregistrement REX:</strong> {company.date_enregistrement_rex || 'N/A'}</p>
                              <p><strong>Début validité REX:</strong> {company.debut_validite_rex || 'N/A'}</p>
                              <p><strong>Fin validité REX:</strong> {company.fin_validite_rex || 'N/A'}</p>
                              <p><strong>Identifiant national:</strong> {company.identifiant_national || 'N/A'}</p>
                                  <p><strong>Date de création:</strong> {company.date_create || 'N/A'}</p>
                              <p><strong>Pays:</strong> {paysList.find(p => p.isoNumeric === company.pays)?.libelle || company.pays || 'N/A'}</p>
                              <p><strong>GLN:</strong> {company.gln || 'N/A'}</p>
                              <p><strong>Site:</strong> {company.site || 'N/A'}</p>
                              <p><strong>Service:</strong> {company.service || 'N/A'}</p>
                              <p><strong>Téléphone:</strong> {company.telephone || 'N/A'}</p>
                              <p><strong>Fax:</strong> {company.fax || 'N/A'}</p>
                              <p><strong>Localité:</strong> {company.localite || 'N/A'}</p>
                              <p><strong>Code postal:</strong> {company.postalCode || 'N/A'}</p>
                            </div>
                            <div>
                              <p><strong>Type:</strong> {typeOptions.find(t => t.value === company.type_prod.toString())?.label || 'N/A'}</p>
                              <p><strong>Date d'abonnement:</strong> {company.date_abonnement || 'N/A'}</p>
                              <p><strong>Nombre de FP:</strong> {company.nb_fp || 0}</p>
                              <p><strong>Statut entité:</strong> {company.status_ent === 'A' ? 'Actif' : company.status_ent === 'E' ? 'En attente' : 'Inactif'}</p>
                              <p><strong>Délégation:</strong> {company.delegation || 'N/A'}</p>
                            </div>
                            {shouldShowDescriptions(company) && (
                              <div className="col-span-2">
                                <p><strong>Description FR:</strong> {renderFormattedText(company.titre_fr, company.id_entite, 'fr', 'Description FR')}</p>
                                <p><strong>Description AR:</strong> {renderFormattedText(company.titre_ar, company.id_entite, 'ar', 'Description AR')}</p>
                                <p><strong>Description EN:</strong> {renderFormattedText(company.titre_en, company.id_entite, 'en', 'Description EN')}</p>
                              </div>
                            )}
                          </div>
                        </td>
                      </tr>
                    )}
                  </React.Fragment>
                ))}
              </tbody>
            </table>
          </div>
          <div className="mt-4 flex justify-between items-center">
            <div className="flex items-center space-x-2">
              <span className="text-sm">Afficher</span>
              <select
                value={itemsPerPage}
                onChange={e => {
                  setItemsPerPage(Number(e.target.value));
                  setCurrentPage(1);
                }}
                className="p-1 border rounded text-sm"
              >
                <option value={10}>10</option>
                <option value={25}>25</option>
                <option value={50}>50</option>
               
              </select>
              <span className="text-sm">par page</span>
            </div>
            <div className="flex space-x-2">
              <button
                className="px-3 py-1 bg-blue-950 text-white rounded disabled:opacity-50"
                onClick={() => setCurrentPage(p => Math.max(p - 1, 1))}
                disabled={currentPage === 1}
              >
                Précédent
              </button>
              <span className="text-sm">Page {currentPage} sur {Math.ceil(filteredCompanies.length / itemsPerPage)}</span>
              <button
                className="px-3 py-1 bg-blue-950 text-white rounded disabled:opacity-50"
                onClick={() => setCurrentPage(p => p + 1)}
                disabled={currentPage >= Math.ceil(filteredCompanies.length / itemsPerPage)}
              >
                Suivant
              </button>
            </div>
          </div>

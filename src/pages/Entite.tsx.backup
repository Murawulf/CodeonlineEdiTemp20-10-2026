                        }}
                        className="p-1 border rounded text-sm"
                      >
                        <option value={10}>10</option>
                        <option value={25}>25</option>
                        <option value={50}>50</option>
                       
                      </select>
                    </div>
                    {canWrite && (
                      <div className="relative" ref={mainActionRef} style={{ flexShrink: 0 }}>
                        <button
                          className="px-4 py-2 bg-blue-950 text-white rounded-md hover:bg-blue-900 text-sm h-10"
                          onClick={() => {
                            setIsMainActionOpen(!isMainActionOpen);
                            setIsRegionOpen(false);
                            setIsSegmentOpen(false);
                            setIsDelegationOpen(false);
                            setIsTypeOpen(false);
                          }}
                        >
                          Actions
                        </button>
                        {isMainActionOpen && (
                          <div className="absolute z-50 mt-2 right-0 bg-white border-2 border-gray-400 rounded-md shadow-lg">

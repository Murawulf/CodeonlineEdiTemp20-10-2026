        setCompanies(companies.filter(c => c.id_entite !== id));
        setIsActionOpen(null);
        debouncedAddNotification('Entreprise supprimée avec succès', 'success');
      } catch (error: any) {
        debouncedAddNotification(`Échec de la suppression: ${error.response?.data?.error || error.message}`, 'error');
        console.error('Delete error:', {
          id_entite: id,
          message: error.message,
          response: error.response?.data,
        });
      }
    }
  };
  const handleSendConnection = async (email: string) => {
    if (!canWrite) {
      debouncedAddNotification('Vous n\'avez pas la permission de modifier', 'error');
      return;
    }
    try {
      await axios.post(`${API_BASE_URL}/api/send-connection`, { email }, { withCredentials: true });
      setIsActionOpen(null);
      debouncedAddNotification('Détails de connexion envoyés avec succès', 'success');
    } catch (error: any) {
      debouncedAddNotification(`Échec de l'envoi des détails: ${error.response?.data?.error || error.message}`, 'error');
      console.error('Send connection error:', {
        email,
        message: error.message,
        response: error.response?.data,
      });
    }
  };
  const handleSort = (key: keyof Company) => {
    let direction: 'ascending' | 'descending' = 'ascending';
    if (sortConfig && sortConfig.key === key && sortConfig.direction === 'ascending') {
      direction = 'descending';
    }
    setSortConfig({ key, direction });
    setCurrentPage(1);
    const sortedCompanies = [...companies].sort((a, b) => {
      let aValue: any = a[key];
      let bValue: any = b[key];
      if (['raison_socialle', 'personne_contact', 'email', 'tel_mobile', 'telephone', 'fax', 'adresse', 'region', 'city', 'localite', 'postalCode', 'gln', 'site', 'date_create', 'service', 'status_ent', 'delegation', 'titre_fr', 'titre_ar', 'titre_en', 'logo'].includes(key)) {
        aValue = aValue || '';
        bValue = bValue || '';
      }
      if (aValue === bValue) return 0;
      if (aValue == null) return 1;
      if (bValue == null) return -1;
      if (typeof aValue === 'string') {
        return direction === 'ascending' ? aValue.localeCompare(bValue, undefined, { sensitivity: 'base' }) : bValue.localeCompare(aValue, undefined, { sensitivity: 'base' });
      }
      if (key === 'nb_fp') {
        aValue = ['I', 'Inactive', 'inactive'].includes(a.status_ent?.toString().toUpperCase()) ? 0 : aValue;
        bValue = ['I', 'Inactive', 'inactive'].includes(b.status_ent?.toString().toUpperCase()) ? 0 : bValue;
      }
      return direction === 'ascending' ? aValue - bValue : bValue - aValue;
    });
    setCompanies(sortedCompanies);
  };
  const toggleActionDropdown = (id: number, event: React.MouseEvent) => {
    event.stopPropagation();
    const button = event.currentTarget as HTMLElement;
    const rect = button.getBoundingClientRect();
    const dropdownWidth = 150;
    const dropdownHeight = 200;
    const viewportWidth = window.innerWidth;
    const viewportHeight = window.innerHeight;
    let left = rect.right - dropdownWidth;
    let top = rect.bottom;
    if (left < 0) left = rect.left;
    if (left + dropdownWidth > viewportWidth) left = viewportWidth - dropdownWidth - 10;
    if (top + dropdownHeight > viewportHeight) top = Math.max(0, rect.top - dropdownHeight);
    setDropdownPosition({ top, left });
    setIsActionOpen(isActionOpen === id ? null : id);
  };
  const renderFormattedText = (text: string | null, companyId: number, lang: string, title: string) => {
    const div = document.createElement('div');
    div.innerHTML = text || '';
    const lineCount = div.innerText.split('\n').length;
    return (
      <div
        className={`max-h-16 overflow-y-auto text-sm transition duration-200 shadow-sm ${lineCount > 5 ? 'text-ellipsis' : ''}`}
        onClick={() => canWrite && openTextModal(text || '', `${lang.toUpperCase()} Description`)}
      >
        <div dangerouslySetInnerHTML={{ __html: text || 'N/A' }} className="mb-1" />
        {lineCount > 5 && (
          <span className="text-blue-950 text-xs">... </span>
        )}
      </div>
    );
  };
  const shouldShowDescriptions = (company: Company) => company.type_prod === 2 || company.type_prod === 6;
  const shouldShowEditDescription = (company: Company) => shouldShowDescriptions(company);
  const totalColumns = 11 + (canWrite ? 1 : 0);
  return (
    <NotificationProvider compteId={compteId}>
      <div className="min-h-screen">
        <nav className="flex items-center space-x-2 text-sm">
          <span
            style={{
              color: '#3b82f6',
              position: 'relative',
              top: '-14px',
              fontWeight: '500',
            }}
          >
            Entité
          </span>
        </nav>
        <style>{`
          .logo-img {
            width: 40px;
            height: 40px;
            object-fit: contain;
            border-radius: 4px;
            cursor: pointer;
          }
          .ql-container {
            font-size: 0.875rem;
          }
          .ql-editor {
            min-height: 150px;
          }
          .action-dropdown {
            position: fixed !important;
            z-index: 9999 !important;
          }
          .loader {
            border: 4px solid #f3f3f3;
            border-top: 4px solid #3498db;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            animation: spin 1s linear infinite;
          }
          @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
          }
        `}</style>
        <div className="container mx-auto p-6 w-[95vw]">
          <table className="w-full table-fixed">
            <tbody>
              <tr>
                <td className="w-[15%] px-2">

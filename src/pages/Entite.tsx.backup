import React, { useState, useEffect, useRef, useCallback } from 'react';
import axios from 'axios';
import ReactQuill from 'react-quill';
import 'react-quill/dist/quill.snow.css';
import Draggable from 'react-draggable';
import { XMarkIcon } from '@heroicons/react/24/outline';
import { NotificationProvider, useNotifications } from '../contexts/NotificationContext';
import { debounce } from 'lodash';
import * as XLSX from 'xlsx';

interface Company {
  id_entite: number;
  identifiant_rex: string | null;
  date_enregistrement_rex: string | null;
  debut_validite_rex: string | null;
  fin_validite_rex: string | null;
  etat: string | null;
  raison_socialle: string;
  identifiant_national: string | null;
  date_create: string | null;
  pays: string | null;
  site: string | null;
  personne_contact: string | null;
  service: string | null;
  email: string | null;
  tel_mobile: string | null;
  telephone: string | null;
  fax: string | null;
  adresse: string | null;
  region: string | null;
  city: string | null;
  localite: string | null;
  postalCode: string | null;
  type_prod: number;
  date_abonnement: string | null;
  date_echeance: string | null;
  pwd: string;
  nb_fp: number;
  inscription: number;
  status_ent: string;
  delegation: string | null;
  titre_fr: string | null;
  titre_ar: string | null;
  titre_en: string | null;
  logo: string | null;
  gln: string | null;
  segments: string[];
}
interface Segment {
  code: string;
  libelle: string;
}
interface Region {
  region: string;
}
interface Delegation {
  delegation: string;
}
interface Pays {
  isoNumeric: string;
  libelle: string;
}
interface SortConfig {
  key: keyof Company;
  direction: 'ascending' | 'descending';
}
interface Permission {
  page_id: number;
  read: number;
  write: number;
  hide: number;
  page_name: string;
}
interface User {
  id_compte: number;
  email: string;
  name: string;
  prenom: string;
  role: string | null;
  is_suspended: number;
  created_at: string;
  id_entite: number;
  producer_name: string;
  profile_id: number;
  permissions: Permission[];
}
const API_BASE_URL = import.meta.env.VITE_API_URL || 'https://edi-dev.codeonline-info.com/';
const typeOptions = [
  { value: '1', label: 'Entreprise privée produits & services' },
  { value: '2', label: 'Entreprise privée ingénierie & services' },
  { value: '3', label: 'Entreprise privée transport logistique & stockage' },
  { value: '4', label: 'Entreprise publique transport logistique & stockage' },
  { value: '5', label: 'Entreprise publique produits & services' },
  { value: '6', label: 'Entreprise publique ingénierie & services' },
  { value: '7', label: 'Autre institution publique d’appui à l’exportation' },
  { value: '8', label: 'Banque' },
  { value: '9', label: 'Douane' },
  { value: '10', label: 'Assurance' },
];
const quillModules = {
  toolbar: [
    [{ header: [1, 2, 3, false] }],
    ['bold', 'italic', 'underline'],
    [{ color: [] }],
    [{ align: [] }],
    ['clean'],
  ],
};
const convertDate = (dateStr: string | null): string | null => {
  if (!dateStr) return null;
  const parts = dateStr.split('/');
  if (parts.length !== 3) return dateStr;
  return `${parts[2]}-${parts[1].padStart(2, '0')}-${parts[0].padStart(2, '0')}`;
};
const Entite: React.FC = () => {
  const [companies, setCompanies] = useState<Company[]>([]);
  const [segments, setSegments] = useState<Segment[]>([]);
  const [regions, setRegions] = useState<Region[]>([]);
  const [delegations, setDelegations] = useState<Delegation[]>([]);
  const [paysList, setPaysList] = useState<Pays[]>([]);
  const [searchRegion, setSearchRegion] = useState<string>('');
  const [searchSegment, setSearchSegment] = useState<string>('');
  const [searchDelegation, setSearchDelegation] = useState<string>('');
  const [searchType, setSearchType] = useState<string>('');
  const [searchText, setSearchText] = useState<string>('');
  const [expandedRow, setExpandedRow] = useState<number | null>(null);
  const [editingCompany, setEditingCompany] = useState<Company | null>(null);
  const [editingField, setEditingField] = useState<{ id: number; field: string; value: string } | null>(null);
const [isModalOpen, setIsModalOpen] = useState<boolean>(false);

// --- NEW: Basic modal state (Option A: small first-step modal) ---
const [isBasicModalOpen, setIsBasicModalOpen] = useState<boolean>(false);
const [basicEditingCompany, setBasicEditingCompany] = useState<Partial<Company> | null>(null);

  const [isImportModalOpen, setIsImportModalOpen] = useState<boolean>(false);
  const [isLoading, setIsLoading] = useState<boolean>(false);
  const [isLogoModalOpen, setIsLogoModalOpen] = useState<boolean>(false);
  const [selectedLogo, setSelectedLogo] = useState<string | null>(null);
  const [modalSegments, setModalSegments] = useState<string[]>([]);
  const [isSelectLangModalOpen, setIsSelectLangModalOpen] = useState<boolean>(false);
  const [isEditTitleModalOpen, setIsEditTitleModalOpen] = useState<boolean>(false);
  const [isTextModalOpen, setIsTextModalOpen] = useState<boolean>(false);
  const [selectedText, setSelectedText] = useState<string>('');
  const [selectedTextTitle, setSelectedTextTitle] = useState<string>('');
  const [selectedLang, setSelectedLang] = useState<'fr' | 'ar' | 'en' | null>(null);
  const [editTitle, setEditTitle] = useState<string>('');
  const [currentPage, setCurrentPage] = useState<number>(1);
  const [itemsPerPage, setItemsPerPage] = useState<number>(25);
  const [sortConfig, setSortConfig] = useState<SortConfig | null>(null);
  const [isRegionOpen, setIsRegionOpen] = useState<boolean>(false);
  const [isSegmentOpen, setIsSegmentOpen] = useState<boolean>(false);
  const [isDelegationOpen, setIsDelegationOpen] = useState<boolean>(false);
  const [isTypeOpen, setIsTypeOpen] = useState<boolean>(false);
  const [isActionOpen, setIsActionOpen] = useState<number | null>(null);
  const [isMainActionOpen, setIsMainActionOpen] = useState<boolean>(false);
  const [profileExists, setProfileExists] = useState<{ [key: number]: boolean }>({});
  const [canWrite, setCanWrite] = useState<boolean>(false);
  const [dropdownPosition, setDropdownPosition] = useState<{ top: number; left: number } | null>(null);
  const [previewLogo, setPreviewLogo] = useState<string | null>(null);
  const [logoFile, setLogoFile] = useState<File | null>(null);
  const [compteId, setCompteId] = useState<number | null>(null);
  const [logoErrorCount, setLogoErrorCount] = useState<{ [key: number]: number }>({});
  const [user, setUser] = useState<User | null>(null);
  const [showAll, setShowAll] = useState<boolean>(false);
  const { addNotification } = useNotifications();
  const regionRef = useRef<HTMLDivElement>(null);
  const segmentRef = useRef<HTMLDivElement>(null);
  const delegationRef = useRef<HTMLDivElement>(null);
  const typeRef = useRef<HTMLDivElement>(null);
  const modalRef = useRef<HTMLDivElement>(null);
  const mainActionRef = useRef<HTMLDivElement>(null);
  const selectLangModalRef = useRef<HTMLDivElement>(null);
  const editTitleModalRef = useRef<HTMLDivElement>(null);
  const textModalRef = useRef<HTMLDivElement>(null);
  const logoModalRef = useRef<HTMLDivElement>(null);
  const importModalRef = useRef<HTMLDivElement>(null);
  const tableRef = useRef<HTMLDivElement>(null);
  const handleTableScroll = useCallback(() => {
    setIsActionOpen(null);
    setDropdownPosition(null);
  }, []);
  const debouncedAddNotification = useCallback(
    debounce((message: string, type: string) => {
      addNotification(message, type);
    }, 1000),
    [addNotification]
  );
  const getLogoUrl = (logo: string | null): string => {
    if (!logo) return '/fallback-logo.png';
    if (logo.startsWith('data:') || logo.startsWith('http')) return logo;
    const cleanPath = logo.startsWith('/') ? logo : '/' + logo;
    return `${API_BASE_URL}${cleanPath}?t=${Date.now()}`;
  };
  const handleLogoError = (e: React.SyntheticEvent<HTMLImageElement>, id: number) => {
    e.currentTarget.src = '/fallback-logo.png';
    setLogoErrorCount((prev) => {
      const newCount = (prev[id] || 0) + 1;
      if (newCount === 1) {
        debouncedAddNotification(`Échec du chargement du logo pour l'ID ${id}`, 'error');
        setCompanies((prevCompanies) =>
          prevCompanies.map((c) => {
            if (c.id_entite === id) {
              return { ...c, logo: null };
            }
            return c;
          })
        );
      }
      return { ...prev, [id]: newCount };
    });
  };
  const handleLogoFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;
    if (file.size > 2097152) {
      addNotification('Fichier trop volumineux (max 2 Mo)', 'error');
      return;
    }
    if (!file.type.startsWith('image/')) {
      addNotification('Type de fichier non supporté', 'error');
      return;
    }
    setLogoFile(file);
    setPreviewLogo(URL.createObjectURL(file));
  };
  const handleLogoDelete = () => {
    setLogoFile(null);
    setPreviewLogo(null);
  };
  useEffect(() => {
    const userData = localStorage.getItem('user');
    if (userData) {
      try {
        const parsedUser: User = JSON.parse(userData);
        setUser(parsedUser);
        setCompteId(parsedUser.id_compte);
        const entitePermission = parsedUser.permissions.find(p => p.page_id === 2);
        setCanWrite(entitePermission ? entitePermission.write === 1 : false);
        setShowAll(parsedUser.id_entite === 111 || parsedUser.id_entite === 999);
      } catch (error) {
        console.error('Error parsing user data from localStorage:', error);
        setCanWrite(false);
        setCompteId(null);
        setShowAll(false);
        debouncedAddNotification('Erreur de chargement des données utilisateur', 'error');
      }
    } else {
      setCanWrite(false);
      setCompteId(null);
      setShowAll(false);
    }
  }, [debouncedAddNotification]);
  useEffect(() => {
    fetchCompanies();
    fetchSegments();
    fetchRegions();
    fetchDelegations();
    fetchPays();
  }, [searchRegion, searchSegment, searchDelegation, searchType]);
  const fetchPays = async () => {
    try {
      const response = await axios.get(`${API_BASE_URL}/api/pays`, { withCredentials: true });
      setPaysList(response.data);
    } catch (error: any) {
      debouncedAddNotification('Échec de la récupération des pays', 'error');
      console.error('Fetch pays error:', { message: error.message, response: error.response?.data });
    }
  };
  const checkProfilesExist = useCallback(async (ids: number[]) => {
    if (!ids || ids.length === 0) return;
    const results: { [key: number]: boolean } = {};
    for (const id of ids) {
      try {
        const response = await axios.get(`${API_BASE_URL}/api/check-supervisor-profile/${id}`, { withCredentials: true });
        results[id] = response.data.exists;
      } catch (error: any) {
        console.error('Error checking supervisor profile:', {
          id_entite: id,
          message: error.message,
          response: error.response?.data,
        });
        results[id] = false;
      }
    }
    setProfileExists(prev => ({ ...prev, ...results }));
  }, []);
 const baseCompanies = showAll
  ? companies.filter(c => ![111, 999].includes(c.id_entite)) // admin-like views see all except 111 & 999
  : companies.filter(c => c.id_entite === user.id_entite && ![111, 999].includes(c.id_entite));


  const filteredCompanies = baseCompanies.filter(company =>
    company.raison_socialle.toLowerCase().includes(searchText.toLowerCase()) ||
    (company.personne_contact || '').toLowerCase().includes(searchText.toLowerCase()) ||
    (company.email || '').toLowerCase().includes(searchText.toLowerCase())
  );
  const paginatedCompanies = filteredCompanies.slice(
    (currentPage - 1) * itemsPerPage,
    currentPage * itemsPerPage
  );
  const visibleTotal = Math.min(baseCompanies.length, 9999);
  useEffect(() => {
    if (paginatedCompanies.length > 0 && canWrite) {
      const ids = paginatedCompanies.map(c => c.id_entite).filter(id => !(id in profileExists));
      if (ids.length > 0) {
        checkProfilesExist(ids);
      }
    }
  }, [paginatedCompanies, profileExists, checkProfilesExist, canWrite]);
  useEffect(() => {
    const handleClickOutside = (event: MouseEvent) => {
      if (
        regionRef.current && !regionRef.current.contains(event.target as Node) &&
        segmentRef.current && !segmentRef.current.contains(event.target as Node) &&
        delegationRef.current && !delegationRef.current.contains(event.target as Node) &&
        typeRef.current && !typeRef.current.contains(event.target as Node) &&
        modalRef.current && !modalRef.current.contains(event.target as Node) &&
        mainActionRef.current && !mainActionRef.current.contains(event.target as Node) &&
        selectLangModalRef.current && !selectLangModalRef.current.contains(event.target as Node) &&
        editTitleModalRef.current && !editTitleModalRef.current.contains(event.target as Node) &&
        textModalRef.current && !textModalRef.current.contains(event.target as Node) &&
        logoModalRef.current && !logoModalRef.current.contains(event.target as Node) &&
        importModalRef.current && !importModalRef.current.contains(event.target as Node)
      ) {
        setIsRegionOpen(false);
        setIsSegmentOpen(false);
        setIsDelegationOpen(false);
        setIsTypeOpen(false);
        setIsMainActionOpen(false);
        setIsModalOpen(false);
        setIsImportModalOpen(false);
        setIsSelectLangModalOpen(false);
        setIsEditTitleModalOpen(false);
        setIsTextModalOpen(false);
        setIsLogoModalOpen(false);
        setIsActionOpen(null);
        setDropdownPosition(null);
      }
    };
    document.addEventListener('mousedown', handleClickOutside);
    return () => document.removeEventListener('mousedown', handleClickOutside);
  }, []);
  useEffect(() => {
    const tableElement = tableRef.current;
    if (tableElement) {
      tableElement.addEventListener('scroll', handleTableScroll);
      return () => tableElement.removeEventListener('scroll', handleTableScroll);
    }
  }, [handleTableScroll]);
  useEffect(() => {
    if (editingCompany?.region && editingCompany.region !== searchRegion) {
      fetchDelegations(editingCompany.region as string);
      setEditingCompany(prev => prev ? { ...prev, city: null, delegation: null } : null);
    }
  }, [editingCompany?.region, searchRegion]);
  const fetchCompanies = async (retries = 3) => {
    try {
      const response = await axios.get(`${API_BASE_URL}/api/companies`, {
        params: { region: searchRegion, segment: searchSegment, delegation: searchDelegation, type: searchType },
        headers: { 'x-api-pin': '3311' },
        withCredentials: true,
      });
      setCompanies(response.data.map((c: Company) => ({
        ...c,
        date_create: convertDate(c.date_create),
        date_abonnement: convertDate(c.date_abonnement),
        date_echeance: convertDate(c.date_echeance),
        date_enregistrement_rex: convertDate(c.date_enregistrement_rex),
        debut_validite_rex: convertDate(c.debut_validite_rex),
        fin_validite_rex: convertDate(c.fin_validite_rex),
      })));
    } catch (error: any) {
      if (error.response?.status === 500 && retries > 0) {
        console.warn(`Retrying fetchCompanies (attempts left: ${retries})`);
        setTimeout(() => fetchCompanies(retries - 1), 1000);
        return;
      }
      debouncedAddNotification('Échec de la récupération des entreprises', 'error');
      console.error('Fetch companies error:', { message: error.message, response: error.response?.data });
    }
  };
  const fetchSegments = async () => {
    try {
      const response = await axios.get(`${API_BASE_URL}/api/segments`, { withCredentials: true });
      setSegments(response.data);
    } catch (error: any) {
      debouncedAddNotification('Échec de la récupération des segments', 'error');
      console.error('Fetch segments error:', { message: error.message, response: error.response?.data });
    }
  };
  const fetchRegions = async () => {
    try {
      const response = await axios.get(`${API_BASE_URL}/api/regions`, { withCredentials: true });
      setRegions(response.data);
    } catch (error: any) {
      debouncedAddNotification('Échec de la récupération des régions', 'error');
      console.error('Fetch regions error:', { message: error.message, response: error.response?.data });
    }
  };
  const fetchDelegations = async (region: string = searchRegion) => {
    try {
      const response = await axios.get(`${API_BASE_URL}/api/delegations`, {
        params: { region },
        withCredentials: true,
      });
      setDelegations(response.data);
    } catch (error: any) {
      debouncedAddNotification('Échec de la récupération des délégations', 'error');
      console.error('Fetch delegations error:', { message: error.message, response: error.response?.data });
    }
  };
  const handleCreateSupervisorProfile = async (company: Company) => {
    if (!canWrite) {
      debouncedAddNotification('Vous n\'avez pas la permission de modifier', 'error');
      return;
    }
    try {
      await axios.post(
        `${API_BASE_URL}/api/create-supervisor-profile`,
        { id_entite: company.id_entite, raison_socialle: company.raison_socialle },
        { withCredentials: true }
      );
      setProfileExists(prev => ({ ...prev, [company.id_entite]: true }));
      setIsActionOpen(null);
      debouncedAddNotification('Profil superviseur créé avec succès', 'success');
    } catch (error: any) {
      debouncedAddNotification(`Échec de la création du profil superviseur: ${error.response?.data?.error || error.message}`, 'error');
      console.error('Create supervisor profile error:', {
        id_entite: company.id_entite,
        message: error.message,
        response: error.response?.data,
      });
    }
  };
  const handleRegionSelect = (region: string) => {
    setSearchRegion(region);
    setSearchDelegation('');
    fetchDelegations(region);
    setIsRegionOpen(false);
    setIsSegmentOpen(false);
    setIsDelegationOpen(false);
    setIsTypeOpen(false);
    setCurrentPage(1);
  };
  const handleSegmentSelect = (segment: string) => {
    setSearchSegment(segment);
    setIsSegmentOpen(false);
    setIsRegionOpen(false);
    setIsDelegationOpen(false);
    setIsTypeOpen(false);
    setCurrentPage(1);
  };
  const handleDelegationSelect = (delegation: string) => {
    setSearchDelegation(delegation);
    setIsDelegationOpen(false);
    setIsRegionOpen(false);
    setIsSegmentOpen(false);
    setIsTypeOpen(false);
    setCurrentPage(1);
  };
  const handleTypeSelect = (type: string) => {
    setSearchType(type);
    setIsTypeOpen(false);
    setIsRegionOpen(false);
    setIsSegmentOpen(false);
    setIsDelegationOpen(false);
    setCurrentPage(1);
  };
  const handleModalRegionChange = (e: React.ChangeEvent<HTMLSelectElement>) => {
    const newRegion = e.target.value || null;
    setEditingCompany(prev => prev ? { ...prev, region: newRegion, city: null, delegation: null } : null);
    if (newRegion) {
      fetchDelegations(newRegion);
    } else {
      setDelegations([]);
    }
  };
  const handleModalCityChange = (e: React.ChangeEvent<HTMLSelectElement>) => {
    const newCity = e.target.value || null;
    setEditingCompany(prev => prev ? { ...prev, city: newCity, delegation: newCity } : null);
  };
  const toggleRow = (id: number) => {
    setExpandedRow(expandedRow === id ? null : id);
  };
// --- REPLACEMENT: handleAddCompany + handleSaveBasicCompany ---
const handleAddCompany = async () => {
  if (!canWrite) {
    debouncedAddNotification('Vous n\'avez pas la permission de modifier', 'error');
    return;
  }
  const today = new Date().toISOString().split('T')[0];
  // initialize the minimal object for the basic modal
  setBasicEditingCompany({
    raison_socialle: '',
    identifiant_national: '',
    personne_contact: '',
    email: '',
    tel_mobile: '',
    telephone: '',
    type_prod: 0, // will be selected by user
    date_create: today,
    segments: [],
  });
  // open the basic modal
  setIsBasicModalOpen(true);
  setModalSegments([]); // keep modalSegments clear for later
  setLogoFile(null);
  setPreviewLogo(null);
  setIsActionOpen(null);
  setIsMainActionOpen(false);
};


const handleSaveBasicCompany = async () => {
  if (!basicEditingCompany) return;

  // ✅ Validation
  if (!basicEditingCompany.raison_socialle?.trim()) {
    debouncedAddNotification("Raison sociale est requise", "error");
    return;
  }
  if (!basicEditingCompany.identifiant_national?.trim()) {
    debouncedAddNotification("Identifiant national est requis", "error");
    return;
  }
  if (!basicEditingCompany.personne_contact?.trim()) {
    debouncedAddNotification("Personne de contact est requise", "error");
    return;
  }

  const typeVal = Number(basicEditingCompany.type_prod || 0);
  if (typeVal === 0) {
    debouncedAddNotification("Type d'opérateur est requis", "error");
    return;
  }

  try {
    const formData = new FormData();

    formData.append("raison_socialle", basicEditingCompany.raison_socialle.trim());
    formData.append("identifiant_national", basicEditingCompany.identifiant_national.trim());
    formData.append("personne_contact", basicEditingCompany.personne_contact.trim());
    formData.append("type_prod", String(typeVal));

    // LE BACKEND VEUT CES CHAMPS MÊME VIDES
    formData.append("email", basicEditingCompany.email || "");
    formData.append("tel_mobile", basicEditingCompany.tel_mobile || "");
    formData.append("telephone", basicEditingCompany.telephone || "");
    formData.append("service", "");
    formData.append("pays", String(basicEditingCompany.pays || 788)); // default to 788
    formData.append("adresse", basicEditingCompany.adresse || "");
    formData.append("region", basicEditingCompany.region || "");
    formData.append("city", basicEditingCompany.city || "");
    formData.append("localite", basicEditingCompany.localite || "");
    formData.append("postalCode", basicEditingCompany.postalCode || "");
    formData.append("gln", basicEditingCompany.gln || "");
    formData.append("titre_fr", basicEditingCompany.titre_fr || "");
    formData.append("titre_ar", basicEditingCompany.titre_ar || "");
    formData.append("titre_en", basicEditingCompany.titre_en || "");
    formData.append("delegation", basicEditingCompany.delegation || "");
    // PAS DE SEGMENTS ICI
    // PAS DE STATUS_ENT ICI

    const response = await axios.post(`${API_BASE_URL}/api/companies`, formData, {
      withCredentials: true,
      headers: { "Content-Type": "multipart/form-data", "x-api-pin": "3311" }
    });

    const newId = response.data?.id_entite;
    if (!newId) throw new Error("Server did not return id_entite");

    debouncedAddNotification(
      "Entité créée. Vous pouvez maintenant compléter les informations.",
      "success"
    );

    setIsBasicModalOpen(false);

    await fetchCompanies();
    setCurrentPage(1);

    const created = (await axios.get(`${API_BASE_URL}/api/companies`, {
      params: { region: searchRegion, segment: searchSegment, delegation: searchDelegation, type: searchType },
      headers: { "x-api-pin": "3311" },
      withCredentials: true
    })).data.find((c: Company) => c.id_entite === newId);

    if (created) {
      setEditingCompany(created);
      setModalSegments(created.segments?.slice(0, 4) || []);
      setIsModalOpen(true);
    }
  } catch (err: any) {
    debouncedAddNotification(`Erreur création: ${err.response?.data?.error || err.message}`, "error");
    console.error(err.response?.data || err);
  }
};


  const handleAddMultiple = () => {
    if (!canWrite) {
      debouncedAddNotification('Vous n\'avez pas la permission de modifier', 'error');
      return;
    }
    setIsImportModalOpen(true);
    setIsMainActionOpen(false);
  };
const handleExport = () => {
  const exportData = filteredCompanies.map((company) => {
    const segmentsData = company.segments?.slice(0, 4) || [];
    return {
      id_entite: company.id_entite,
      identifiant_rex: company.identifiant_rex || '',
      date_enregistrement_rex: company.date_enregistrement_rex || '',
      debut_validite_rex: company.debut_validite_rex || '',
      fin_validite_rex: company.fin_validite_rex || '',
      etat: company.etat || '',
      raison_sociale: company.raison_socialle,
      identifiant_national: company.identifiant_national || '',
      date_create: company.date_create || '',
      pays: paysList.find(p => p.isoNumeric === company.pays)?.libelle || company.pays || '',
      site: company.site || '',
      personne_contact: company.personne_contact || '',
      service: company.service || '',
      email: company.email || '',
      tel_mobile: company.tel_mobile || '',
      telephone: company.telephone || '',
      fax: company.fax || '',
      adresse: company.adresse || '',
      region: company.region || '',
      city: company.city || '',
      localite: company.localite || '',
      postalCode: company.postalCode || '',
      type_operateur: typeOptions.find(t => t.value === company.type_prod.toString())?.label || '',
      date_abonnement: company.date_abonnement || '',
      date_echeance: company.date_echeance || '',
      pwd: company.pwd,
      nb_fp: company.nb_fp,
      inscription: company.inscription,
      status_ent: company.status_ent,
      delegation: company.delegation || '',
      titre_fr: company.titre_fr || '',
      titre_ar: company.titre_ar || '',
      titre_en: company.titre_en || '',
      logo: company.logo || '',
      gln: company.gln || '',
      segment1: segments.find(s => s.code === segmentsData[0])?.libelle || '',
      segment2: segments.find(s => s.code === segmentsData[1])?.libelle || '',
      segment3: segments.find(s => s.code === segmentsData[2])?.libelle || '',
      segment4: segments.find(s => s.code === segmentsData[3])?.libelle || '',
    };
  });

  const ws = XLSX.utils.json_to_sheet(exportData);
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, 'Entites');
  XLSX.writeFile(wb, 'entites_export.xlsx');
  addNotification('Exportation réussie', 'success');
  setIsMainActionOpen(false);
};
const downloadTemplate = async () => {
  try {
    const response = await axios.get(`${API_BASE_URL}/api/companies/template`, {
      responseType: "blob",
      withCredentials: true,
    });
    const url = window.URL.createObjectURL(new Blob([response.data]));
    const link = document.createElement("a");
    link.href = url;
    link.setAttribute("download", "modele_entites_complet.xlsx");
    document.body.appendChild(link);
    link.click();
    link.remove();
    addNotification("Modèle Excel téléchargé avec succès", "success");
  } catch (error) {
    console.error("Erreur téléchargement modèle:", error);
    addNotification("Erreur lors du téléchargement du modèle Excel", "error");
  }
};
const handleFileUpload = async (e: React.ChangeEvent<HTMLInputElement>) => {
  const file = e.target.files?.[0];
  if (!file) return;
  setIsLoading(true);

  try {
    const data = await file.arrayBuffer();
    const wb = XLSX.read(data);
    const ws = wb.Sheets[wb.SheetNames[0]];
    const json: any[][] = XLSX.utils.sheet_to_json(ws, { header: 1, raw: false });

    if (!json || json.length < 1) {
      debouncedAddNotification("Fichier Excel vide ou mal formé", "error");
      setIsLoading(false);
      return;
    }

    const headerRow = (json[0] || []).map(h => (h || "").toString().trim());
    const entities: any[] = [];
    const errors: string[] = [];

    for (let i = 1; i < json.length; i++) {
      const row = json[i];
      if (!row || row.every((c: any) => !c)) continue;

      try {
        const entity: any = {};

        headerRow.forEach((hRaw, idx) => {
          if (!hRaw) return;
          const key = hRaw.replace("*", "").trim();
          let val = row[idx];
          if (typeof val === "string") val = val.trim();
          if (val !== undefined && val !== null && val !== "") entity[key] = val;
        });

        // Fix old/new key names
        if (entity.raison_socialle && !entity.raison_sociale) {
          entity.raison_sociale = entity.raison_socialle;
          delete entity.raison_socialle;
        }
        if (entity.type_prod && !entity.type_operateur) {
          entity.type_operateur = entity.type_prod;
          delete entity.type_prod;
        }

        // Numbers
        ["nb_fp", "inscription"].forEach(k => {
          if (entity[k] !== undefined) entity[k] = Number(entity[k]);
        });

        // Dropdown mappings
        let typeField = entity.type_operateur || entity.type_prod;
        if (typeField !== undefined) {
          const inputStr = String(typeField).trim();
          const inputLower = inputStr.toLowerCase();
          const found = typeOptions.find(
            t => t.label.toLowerCase() === inputLower || t.value === inputStr
          );
          entity.type_prod = found ? Number(found.value) : 1; // Default to 1 if no match
        } else {
          entity.type_prod = 1; // Default if missing
        }

        // For pays
        if (entity.pays !== undefined) {
          const inputStr = String(entity.pays).trim();
          const inputLower = inputStr.toLowerCase();
          let found = paysList.find(
            p => p.libelle.toLowerCase() === inputLower || p.isoNumeric === inputStr
          );
          if (!found && inputStr.includes(' ')) {
            const parts = inputStr.split(' ');
            const possibleCode = parts[0];
            const possibleLib = parts.slice(1).join(' ').toLowerCase();
            found = paysList.find(
              p => p.isoNumeric === possibleCode && p.libelle.toLowerCase() === possibleLib
            );
          }
          entity.pays = found ? found.isoNumeric : inputStr;
        }

        // For region
        if (entity.region !== undefined) {
          const inputStr = String(entity.region).trim();
          const inputLower = inputStr.toLowerCase();
          const found = regions.find(r => r.region.toLowerCase() === inputLower);
          entity.region = found ? found.region : inputStr;
        }

        // Segments (1–4)
        const segNames = [entity.segment1, entity.segment2, entity.segment3, entity.segment4]
          .filter(Boolean)
          .map(s => String(s).trim());
        const segCodes: string[] = [];
        for (const name of segNames) {
          let codeCandidate = name;
          let found = segments.find((s: Segment) => s.code === codeCandidate || s.libelle === name);
          if (!found && name.includes(' ')) {
            const parts = name.split(' ');
            codeCandidate = parts[0];
            const lib = parts.slice(1).join(' ');
            found = segments.find((s: Segment) => s.code === codeCandidate && s.libelle === lib);
          }
          if (found) {
            segCodes.push(found.code);
          } else {
            errors.push(`Ligne ${i + 1}: Segment non trouvé - ${name}`);
          }
        }
        entity.segments = segCodes.slice(0, 4);
        delete entity.segment1;
        delete entity.segment2;
        delete entity.segment3;
        delete entity.segment4;

        if (!entity.status_ent) entity.status_ent = "E";

        const missing = [];
        if (!entity.raison_sociale) missing.push("raison_sociale");
        if (!entity.identifiant_national) missing.push("identifiant_national");
        if (!entity.personne_contact) missing.push("personne_contact");
        if (entity.type_prod === 0) missing.push("type_prod"); // Only if still 0, but we set to 1
        if (missing.length) {
          errors.push(`Ligne ${i + 1}: champs manquants (${missing.join(", ")})`);
          continue;
        }

        entities.push(entity);
      } catch (err: any) {
        errors.push(`Ligne ${i + 1}: Erreur de traitement - ${err.message}`);
      }
    }

    if (entities.length === 0) {
      debouncedAddNotification(
        errors.length ? `Aucune entité valide trouvée (${errors.length} erreurs)` : "Aucune donnée trouvée dans le fichier",
        "error"
      );
      if (errors.length) {
        debouncedAddNotification(errors.join('\n'), "error");
      }
      console.warn("Import errors:", errors);
      setIsLoading(false);
      return;
    }

    const response = await axios.post(`${API_BASE_URL}/api/companies/import`, { entities }, { withCredentials: true });

    debouncedAddNotification(`${response.data.added} entités ajoutées avec succès`, "success");

    if (response.data.errors?.length) {
      const errorDetails = response.data.errors.map((err: any) => `${err.raison_socialle || 'Inconnu'}: ${err.message}`).join('\n');
      debouncedAddNotification(`Erreurs lors de l'import:\n${errorDetails}`, "error");
      console.warn("Backend import warnings:", response.data.errors);
    }

    await fetchCompanies();
    setCurrentPage(1);
    setIsImportModalOpen(false);
  } catch (err: any) {
    console.error("Import error:", err);
    debouncedAddNotification(`Échec de l'import: ${err?.message || err}`, "error");
  } finally {
    setIsLoading(false);
  }
};


  const handleEditCompany = (company: Company) => {
    if (!canWrite) {
      debouncedAddNotification('Vous n\'avez pas la permission de modifier', 'error');
      return;
    }
    setEditingCompany({
      ...company,
      date_create: convertDate(company.date_create),
      date_abonnement: convertDate(company.date_abonnement),
      date_echeance: convertDate(company.date_echeance),
      date_enregistrement_rex: convertDate(company.date_enregistrement_rex),
      debut_validite_rex: convertDate(company.debut_validite_rex),
      fin_validite_rex: convertDate(company.fin_validite_rex),
    });
    setModalSegments(company.segments?.slice(0, 4) || []);
    setLogoFile(null);
    setPreviewLogo(company.logo ? getLogoUrl(company.logo) : null);
    fetchDelegations(company.region || '');
    setIsModalOpen(true);
    setIsActionOpen(null);
  };
  const openSelectLangModal = (company: Company) => {
    if (!canWrite) {
      debouncedAddNotification('Vous n\'avez pas la permission de modifier', 'error');
      return;
    }
    setEditingCompany(company);
    setIsSelectLangModalOpen(true);
    setIsActionOpen(null);
  };
  const openEditTitleModal = (lang: 'fr' | 'ar' | 'en') => {
    if (!editingCompany) return;
    setSelectedLang(lang);
    setEditTitle(editingCompany[`titre_${lang}`] || '');
    setIsSelectLangModalOpen(false);
    setIsEditTitleModalOpen(true);
  };
  const openTextModal = (text: string, title: string) => {
    setSelectedText(text);
    setSelectedTextTitle(title);
    setIsTextModalOpen(true);
  };
  const openLogoModal = (logo: string) => {
    setSelectedLogo(logo);
    setIsLogoModalOpen(true);
  };
  const handleEditField = async (id: number, field: string, value: string | null) => {
    if (!canWrite) {
      debouncedAddNotification('Vous n\'avez pas la permission de modifier', 'error');
      return;
    }
    try {
      const company = companies.find(c => c.id_entite === id);
      if (!company) return;
      const updatedCompany = { ...company, [field]: value };
      const formData = new FormData();
      Object.entries(updatedCompany).forEach(([key, val]) => {
        if (val !== null && val !== undefined) formData.append(key, val.toString());
      });
      await axios.put(`${API_BASE_URL}/api/companies/${id}`, formData, {
        withCredentials: true,
         headers: {
      'Content-Type': 'multipart/form-data',
      'x-api-pin': '3311'
    },
      });
      setCompanies(companies.map(c => (c.id_entite === id ? updatedCompany : c)));
      setEditingField(null);
      debouncedAddNotification(`${field} mise à jour avec succès`, 'success');
    } catch (error: any) {
      debouncedAddNotification(`Échec de la mise à jour de ${field}: ${error.response?.data?.error || error.message}`, 'error');
      console.error('Edit field error:', {
        id_entite: id,
        field,
        message: error.message,
        response: error.response?.data,
      });
    }
  };
  const handleTitleUpdate = async () => {
    if (!editingCompany || !selectedLang) return;
    if (!canWrite) {
      debouncedAddNotification('Vous n\'avez pas la permission de modifier', 'error');
      return;
    }
    try {
      const updatedCompany = { ...editingCompany, [`titre_${selectedLang}`]: editTitle };
      const formData = new FormData();
      Object.entries(updatedCompany).forEach(([key, val]) => {
        if (val !== null && val !== undefined) formData.append(key, val.toString());
      });
      await axios.put(`${API_BASE_URL}/api/companies/${editingCompany.id_entite}`, formData, {
        withCredentials: true,
         headers: {
      'Content-Type': 'multipart/form-data',
      'x-api-pin': '3311'
    },
      });
      setCompanies(
        companies.map(c =>
          c.id_entite === editingCompany.id_entite
            ? updatedCompany
            : c
        )
      );
      debouncedAddNotification(`Titre ${selectedLang.toUpperCase()} mis à jour avec succès`, 'success');
      setIsEditTitleModalOpen(false);
      setSelectedLang(null);
      setEditTitle('');
      await fetchCompanies();
    } catch (error: any) {
      debouncedAddNotification(`Échec de la mise à jour du titre ${selectedLang.toUpperCase()}: ${error.response?.data?.error || error.message}`, 'error');
      console.error('Title update error:', {
        id_entite: editingCompany.id_entite,
        field: `titre_${selectedLang}`,
        message: error.message,
        response: error.response?.data,
      });
    }
  };
  const handleSaveCompany = async () => {
    if (!editingCompany) {
      debouncedAddNotification('Aucune entité sélectionnée', 'error');
      return;
    }
    // === REQUIRED FIELDS VALIDATION ===
    if (!editingCompany.raison_socialle?.trim()) {
      debouncedAddNotification('Raison sociale est requise', 'error');
      return;
    }
    if (!editingCompany.identifiant_national?.trim()) {
      debouncedAddNotification('Identifiant national est requis', 'error');
      return;
    }
    if (!editingCompany.personne_contact?.trim()) {
      debouncedAddNotification('Personne de contact est requise', 'error');
      return;
    }
    if (editingCompany.type_prod === 0) {
      debouncedAddNotification('Type d\'opérateur est requis', 'error');
      return;
    }
    try {
      const formData = new FormData();
      const safeAppend = (key: string, value: any) => {
        if (value === null || value === undefined) return;
        const trimmed = String(value).trim();
        if (trimmed !== '') formData.append(key, trimmed);
      };
      // REQUIRED
      formData.append('raison_socialle', editingCompany.raison_socialle.trim());
      formData.append('identifiant_national', editingCompany.identifiant_national.trim());
      formData.append('personne_contact', editingCompany.personne_contact.trim());
      formData.append('type_prod', editingCompany.type_prod.toString());
      formData.append('status_ent', editingCompany.status_ent || 'E');
      // OPTIONAL
      safeAppend('identifiant_rex', editingCompany.identifiant_rex);
      safeAppend('date_enregistrement_rex', editingCompany.date_enregistrement_rex);
      safeAppend('debut_validite_rex', editingCompany.debut_validite_rex);
      safeAppend('fin_validite_rex', editingCompany.fin_validite_rex);
      safeAppend('etat', editingCompany.etat);
      safeAppend('pays', editingCompany.pays);
      safeAppend('site', editingCompany.site);
      safeAppend('service', editingCompany.service);
      safeAppend('email', editingCompany.email);
      safeAppend('tel_mobile', editingCompany.tel_mobile);
      safeAppend('telephone', editingCompany.telephone);
      safeAppend('fax', editingCompany.fax);
      safeAppend('adresse', editingCompany.adresse);
      safeAppend('region', editingCompany.region);
      safeAppend('city', editingCompany.city);
      safeAppend('localite', editingCompany.localite);
      safeAppend('postalCode', editingCompany.postalCode);
      safeAppend('statut', editingCompany.statut);
      safeAppend('date_abonnement', editingCompany.date_abonnement);
      safeAppend('date_echeance', editingCompany.date_echeance);
      safeAppend('pwd', editingCompany.pwd);
      safeAppend('nb_fp', editingCompany.nb_fp);
      safeAppend('inscription', editingCompany.inscription);
      safeAppend('delegation', editingCompany.delegation);
      safeAppend('titre_fr', editingCompany.titre_fr);
      safeAppend('titre_ar', editingCompany.titre_ar);
      safeAppend('titre_en', editingCompany.titre_en);
      safeAppend('gln', editingCompany.gln);
      // SEGMENTS – always JSON string
      formData.append('segments', JSON.stringify(modalSegments));
      // LOGO – only if a new file
      if (logoFile) formData.append('logo', logoFile);
      let response;
      // ──────── CREATE ────────
      if (editingCompany.id_entite === 0) {
        // DEBUG: see exactly what we send
        console.log('%cPOST payload →', 'color:lime', Object.fromEntries(formData));
        response = await axios.post(`${API_BASE_URL}/api/companies`, formData, {
          withCredentials: true,
           headers: {
      'Content-Type': 'multipart/form-data',
      'x-api-pin': '3311'
    },
        });
        // DEBUG: see what the server gave back
        console.log('%cPOST response →', 'color:cyan', response.data);
        const newId = response.data.id_entite;
        if (!newId) throw new Error('Server did not return id_entite');
        const newCompany: Company = {
          ...editingCompany,
          id_entite: newId,
          date_create: new Date().toISOString().split('T')[0],
          logo: logoFile ? URL.createObjectURL(logoFile) : null,
          segments: modalSegments,
        };
        // Optimistic UI + refetch to guarantee DB sync
        setCompanies(prev => [newCompany, ...prev]);
        await fetchCompanies(); // <-- forces fresh list from DB
        setCurrentPage(1); // jump to first page
        debouncedAddNotification('Entité créée avec succès', 'success');
      }
      // ──────── UPDATE ────────
      else {
        response = await axios.put(
          `${API_BASE_URL}/api/companies/${editingCompany.id_entite}`,
          formData,
          {
            withCredentials: true,
         headers: {
    'Content-Type': 'multipart/form-data',
    'x-api-pin': '3311'
  },
          }
        );
        setCompanies(prev =>
          prev.map(c =>
            c.id_entite === editingCompany.id_entite
              ? { ...editingCompany, ...response.data }
              : c
          )
        );
        debouncedAddNotification('Entité mise à jour avec succès', 'success');
      }
      // CLEANUP
      setIsModalOpen(false);
      setLogoFile(null);
      setPreviewLogo(null);
      setModalSegments([]);
      setEditingCompany(null);
      setSelectedLogo(null);
    } catch (error: any) {
      const msg =
        error.response?.data?.error ||
        error.response?.data?.details ||
        error.message ||
        'Erreur inconnue';
      debouncedAddNotification(
        `Échec de la ${editingCompany.id_entite === 0 ? 'création' : 'mise à jour'}: ${msg}`,
        'error'
      );
      console.error('Save company error:', error.response || error);
    }
  };
  const handleDeleteCompany = async (id: number) => {
    if (!canWrite) {
      debouncedAddNotification('Vous n\'avez pas la permission de modifier', 'error');
      return;

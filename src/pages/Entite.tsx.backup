                        <div className="p-2 hover:bg-gray-100 cursor-pointer text-sm" onClick={() => handleDelegationSelect('')}>
                          Toutes les délégations
                        </div>
                        {delegations.map(d => (
                          <div key={d.delegation} className="p-2 hover:bg-gray-100 cursor-pointer text-sm" onClick={() => handleDelegationSelect(d.delegation)}>
                            {d.delegation}
                          </div>
                        ))}

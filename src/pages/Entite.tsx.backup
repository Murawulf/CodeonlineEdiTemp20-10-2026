                            value={editingField.value}
                            onChange={e => setEditingField({ ...editingField, value: e.target.value })}
                            onBlur={() => handleEditField(company.id_entite, 'adresse', editingField.value)}
                            onKeyPress={e => e.key === 'Enter' && handleEditField(company.id_entite, 'adresse', editingField.value)}
                            className="w-full p-1 border rounded"
                            autoFocus
                          />
                        ) : (
                          company.adresse || 'N/A'
                        )}
                      </td>
                      <td
                        className="p-2 truncate"
                        onClick={e => {
                          e.stopPropagation();
                          if (canWrite) {
                            setEditingField({
                              id: company.id_entite,
                              field: 'region',

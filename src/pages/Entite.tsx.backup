                  </th>
                  <th className="w-[10%] p-2 cursor-pointer" onClick={() => handleSort('personne_contact')}>
                    Contact {sortConfig?.key === 'personne_contact' && (sortConfig.direction === 'ascending' ? '▲' : '▼')}
                  </th>
                  <th className="w-[10%] p-2 cursor-pointer" onClick={() => handleSort('email')}>
                    Email {sortConfig?.key === 'email' && (sortConfig.direction === 'ascending' ? '▲' : '▼')}
                  </th>
                  <th className="w-[10%] p-2 cursor-pointer" onClick={() => handleSort('tel_mobile')}>

                            onBlur={() => handleEditField(company.id_entite, 'region', editingField.value)}
                            className="w-full p-1 border rounded"
                            autoFocus
                          >
                            <option value="">Sélectionner</option>
                            {regions.map(r => (
                              <option key={r.region} value={r.region}>{r.region}</option>
                            ))}

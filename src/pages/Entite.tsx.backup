                      <td className="p-2 text-center">{company.id_entite}</td>
                      <td className="p-2 text-center">
                        {company.logo ? (
                          <img
                            src={getLogoUrl(company.logo)}
                            alt="Logo"
                            className="logo-img"
                            onClick={() => openLogoModal(getLogoUrl(company.logo))}

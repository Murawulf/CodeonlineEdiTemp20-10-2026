                              field: 'personne_contact',
                              value: company.personne_contact || '',
                            });
                          }
                        }}
                      >
                        {editingField?.id === company.id_entite && editingField?.field === 'personne_contact' ? (
                          <input
                            type="text"
                            value={editingField.value}
                            onChange={e => setEditingField({ ...editingField, value: e.target.value })}
                            onBlur={() => handleEditField(company.id_entite, 'personne_contact', editingField.value)}
                            onKeyPress={e => e.key === 'Enter' && handleEditField(company.id_entite, 'personne_contact', editingField.value)}
                            className="w-full p-1 border rounded"
                            autoFocus
                          />
                        ) : (
                          company.personne_contact || 'N/A'
                        )}
                      </td>
                      <td
                        className="p-2 truncate"

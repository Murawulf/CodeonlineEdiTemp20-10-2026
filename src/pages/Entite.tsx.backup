            <input
              type="text"
              value={basicEditingCompany.tel_mobile || ''}
              onChange={e => setBasicEditingCompany(prev => ({ ...(prev || {}), tel_mobile: e.target.value }))}
              className="w-full p-2 border rounded text-sm"
            />
          </div>
          <div className="col-span-2">
            <label className="block text-sm font-medium text-gray-700 mb-1">Type d'opérateur *</label>
            <div className="relative">
              <select
                value={(basicEditingCompany.type_prod || 0).toString()}
                onChange={e => setBasicEditingCompany(prev => ({ ...(prev || {}), type_prod: Number(e.target.value) }))}
                className="w-full p-2 border rounded text-sm"
              >
                <option value="0">Choisir un type opérateur</option>
                {typeOptions.map(t => (
                  <option key={t.value} value={t.value}>{t.label}</option>
                ))}
              </select>
            </div>
          </div>

          <div className="col-span-2">
            <label className="block text-sm font-medium text-gray-700 mb-1">Segments (max 4)</label>
            <div className="grid grid-cols-2 gap-2">
              {segments.map(s => (
                <label key={s.code} className="flex items-center space-x-2 text-sm bg-gray-100 p-2 rounded-md hover:bg-gray-200">
                  <input
                    type="checkbox"
                    checked={modalSegments.includes(s.code)}
                    onChange={() => {
                      setModalSegments(prev => {
                        if (prev.includes(s.code)) return prev.filter(code => code !== s.code);
                        if (prev.length < 4) return [...prev, s.code];
                        debouncedAddNotification('Maximum 4 segments autorisés', 'error');
                        return prev;
                      });
                    }}
                    className="rounded text-blue-950 focus:ring-blue-950"
                  />
                  <span>{s.libelle}</span>
                </label>
              ))}
            </div>
          </div>

                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </Draggable>
          )}
          {isLogoModalOpen && selectedLogo && (
            <Draggable handle=".modal-handle">
              <div className="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50 z-50">
                <div className="bg-white rounded-lg shadow-lg w-[90vw] max-w-md" ref={logoModalRef}>
                  <div className="modal-handle bg-blue-950 text-white p-2 flex justify-between items-center cursor-move">
                    <h2 className="text-lg">Aperçu du logo</h2>
                    <button onClick={() => setIsLogoModalOpen(false)} className="text-white hover:text-gray-300">
                      <XMarkIcon className="h-6 w-6" />
                    </button>
                  </div>
                  <div className="p-4 flex justify-center">
<img
    src={selectedLogo}
    alt="Logo"
    className="w-full h-full object-contain rounded-md shadow"
  />
</div>

                </div>
              </div>
            </Draggable>
          )}
        </div>
      </div>
    </NotificationProvider>
  );
};
export default Entite;
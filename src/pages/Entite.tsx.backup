                      </td>
                      <td className="p-2">
                        {company.segments?.slice(0, 4).map(s => segments.find(seg => seg.code === s)?.libelle).filter(Boolean).join(', ') || 'N/A'}
                      </td>
                      {canWrite && (
                        <td className="p-2 text-center relative">
                          <button
                            className="text-blue-950 hover:text-blue-700"
                            onClick={e => toggleActionDropdown(company.id_entite, e)}
                          >
                            ☰
                          </button>
                          {isActionOpen === company.id_entite && dropdownPosition && (
                            <div
                              className="action-dropdown bg-white border-2 border-gray-400 rounded-md shadow-lg text-sm"
                              style={{ top: dropdownPosition.top, left: dropdownPosition.left, width: '150px' }}
                            >
                          {/* -- smart action: Compléter vs Modifier -- */}
{(() => {
  const needsCompletion = (c: Company) => {
    // If any of these extended fields are missing, we consider the company "needs completion"
    const missingFields = [
      'adresse', 'region', 'city', 'gln', 'titre_fr', 'titre_en', 'titre_ar'
    ];
    return missingFields.some(f => {
      const v = (c as any)[f];
      return v === null || v === undefined || (typeof v === 'string' && v.trim() === '');
    });
  };
  return needsCompletion(company) ? (
    <div
      className="p-2 hover:bg-gray-100 cursor-pointer"
      onClick={() => {
        // open the big modal for completing (prefill editingCompany)
        const full = { ...company };
        setEditingCompany({
          ...full,
          date_create: convertDate(full.date_create),
          date_abonnement: convertDate(full.date_abonnement),
          date_echeance: convertDate(full.date_echeance),
          date_enregistrement_rex: convertDate(full.date_enregistrement_rex),
          debut_validite_rex: convertDate(full.debut_validite_rex),
          fin_validite_rex: convertDate(full.fin_validite_rex),
        });
        setModalSegments(company.segments?.slice(0,4) || []);
        setPreviewLogo(company.logo ? getLogoUrl(company.logo) : null);
        fetchDelegations(company.region || '');
        setIsModalOpen(true);
        setIsActionOpen(null);
      }}
    >
      Compléter les informations
    </div>
  ) : (
    <div
      className="p-2 hover:bg-gray-100 cursor-pointer"
      onClick={() => handleEditCompany(company)}
    >
      Modifier
    </div>
  );
})()}

                              {shouldShowEditDescription(company) && (
                                <div
                                  className="p-2 hover:bg-gray-100 cursor-pointer"
                                  onClick={() => openSelectLangModal(company)}
                                >
                                  Modifier description
                                </div>
                              )}
                              {!profileExists[company.id_entite] && (
                                <div
                                  className="p-2 hover:bg-gray-100 cursor-pointer"
                                  onClick={() => handleCreateSupervisorProfile(company)}
                                >
                                  Créer compte administrateur
                                </div>
                              )}
                              {company.email && (
                                <div
                                  className="p-2 hover:bg-gray-100 cursor-pointer"
                                  onClick={() => handleSendConnection(company.email!)}
                                >
                                  Envoyer fiche connexion
                                </div>
                              )}
                              <div
                                className="p-2 hover:bg-gray-100 cursor-pointer text-red-600"
                                onClick={() => handleDeleteCompany(company.id_entite)}
                              >
                                Supprimer
                              </div>
                            </div>
                          )}
                        </td>
                      )}
                    </tr>
                    {expandedRow === company.id_entite && (

#!/usr/bin/expect -f
set timeout 20
set host "217.182.94.86"
set user "Consultant"
set password "A4b6xb1s*"

spawn ssh -o StrictHostKeyChecking=no $user@$host
expect {
    "password:" {
        send "$password\r"
        exp_continue
    }
    -re "\[$#%>] " {
        send "pm2 logs codeonline-edi-tunisie --lines 30 --nostream\r"
    }
}
expect -re "\[$#%>] "
send "exit\r"
expect eof

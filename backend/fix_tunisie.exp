#!/usr/bin/expect -f
set timeout 30
set host "217.182.94.86"
set user "Consultant"
set password "A4b6xb1s*"

# Copier le fichier .env depuis la racine vers le backend
spawn scp -o StrictHostKeyChecking=no /Users/majdhakim/Travail/netconsulting/Codeonline-InfoTn/.env.tunisie $user@$host:/var/www/Edi-dev/backend/.env
expect "*?assword:*" { send "$password\r" }
expect eof

# 2. Se connecter pour tuer le port et relancer PM2
spawn ssh -o StrictHostKeyChecking=no $user@$host
expect "*?assword:*" { send "$password\r" }
expect -re "\[$#%>] " { 
    send "sudo kill -9 \$(sudo lsof -t -i:5001) 2>/dev/null || true\r" 
}
expect "*?assword*" { send "$password\r" }
expect -re "\[$#%>] " { send "pm2 restart codeonline-edi-tunisie\r" }
expect -re "\[$#%>] " { 
    send "pm2 logs codeonline-edi-tunisie --lines 30 --nostream\r" 
}
expect -re "\[$#%>] " { send "exit\r" }
expect eof

# ============================================================================
# Codeonline EDI Orchestrator (PAESN Registry) — variables d'environnement
# ----------------------------------------------------------------------------
# Copier en .env sur chaque serveur et renseigner les valeurs réelles.
# Ce fichier (.env) est git-ignored. NE JAMAIS committer de secrets.
# ============================================================================

# --- Base de données ---
DB_HOST=127.0.0.1
DB_USER=Consultant
DB_PASSWORD=__CHANGEME__
DB_NAME=codeonline_edi_db        # DEV. PROD: codeonline_edi_db_prod

# --- Réseau ---
PORT=5010                        # DEV. PROD: 5012 (cf. deploy/orchestrator.prod.conf)

# --- Authentification inter-services ---
# Secret HS256 PARTAGÉ avec tous les nœuds pays (même valeur partout dans un
# même environnement). Le hub signe un JWT de service avec, les nœuds le
# vérifient via verifyJWT. DEV et PROD doivent avoir des secrets DISTINCTS.
JWT_SECRET=__CHANGEME__

# PIN legacy transmis aux nœuds (en-tête x-api-pin).
API_PIN=__CHANGEME__

# Clé maître de l'API mobile de tracking (en-tête X-Tracking-Api-Key).
TRACKING_API_KEY=__CHANGEME__

# Clé interne du service registry_fp (en-tête x-registry-key).
# Utilisée par les serveurs pays pour interroger l'index produit cross-pays
# (GET /api/registry/fp) et pousser leur catalogue (POST /api/registry/fp/sync).
REGISTRY_API_KEY=__CHANGEME__

# Base des URLs d'images par pays SOURCE (code ISO numérique). Le service
# registry_fp préfixe les chemins relatifs avec la base du pays source (les URLs
# déjà absolues sont conservées). Préfixe par pays source = correct pour le
# fallback cross-pays (le HUB connaît country_code).
# TUN (788) : images déjà absolues -> PAS de base (passthrough).
REGISTRY_IMG_BASE_384=https://civ.codeonline-edi.net          # Côte d'Ivoire
# REGISTRY_IMG_BASE_686=https://...   # Sénégal (à renseigner)
